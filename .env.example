# data-craft-ai-preview 환경 변수 예시
# 실제 값은 .env (gitignore 대상) 또는 배포 환경 변수로 주입.
# 본 파일은 변수 이름만 선언 — 값은 비워둔다.

# --- 서버 런타임 (server.ts) ---
PORT=3000

# SMTP 설정 (문의 폼 이메일 전송)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# --- 향후 사용 예약 (현재 코드에서 미사용) ---
# SEC-DC-011: 클라이언트 번들 유출 금지. 서버 경유 프록시 엔드포인트에서만 사용해야 함.
# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
